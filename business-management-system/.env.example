# Copy this file to .env and replace every CHANGE_ME value.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=business_management
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false

# Used only to create the first administrator if no user exists.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
